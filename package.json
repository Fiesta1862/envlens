{
  "name": "envlens",
  "version": "0.1.0",
  "description": "A tiny CLI that checks .env files against a template",
  "type": "module",
  "bin": {
    "envlens": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && chmod +x dist/cli.js",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "cli",
    "dotenv",
    "env",
    "environment",
    "developer-tools"
  ],
  "author": "Fiesta1862",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fiesta1862/envlens.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
